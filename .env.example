# Participant-issued Memory System Key. Required in any real deployment.
# Never commit the real key; inject via your hosting secret mechanism.
AML_MEMORY_SYSTEM_KEY=

# PostgreSQL DSN, e.g. postgresql://user:pass@host:5432/dbname
# Leave empty to run with in-memory storage (single process, not durable).
DATABASE_URL=

# --- tuning (defaults shown) ---
# ABSTENTION_MIN_SCORE=0.12
# PERSONA_PROMOTION_THRESHOLD=2
# DEFAULT_EXPERT_ROLE=reviewer
# RECENCY_HALF_LIFE_MS=2592000000
# MAX_MESSAGES_PER_ADD=200
